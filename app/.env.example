# Optional — set to enable Tolgee in-context editing & DevTools.
# Leave empty to use only the bundled static translations in src/i18n/.
#
# IMPORTANT: the API key MUST come from the Tolgee project that matches the
# branch you have checked out:
#   - on `main`     → use the key from the dev Tolgee project
#   - on `staging`  → use the key from the staging Tolgee project
# See docs/WORKFLOW.md.
VITE_APP_TOLGEE_API_URL=http://localhost:8200
VITE_APP_TOLGEE_API_KEY=
